# ── OpenRouter (preferred backend — used if OPENROUTER_API_KEY is set) ───────
# Single global key (fallback if per-agent keys are not set):
OPENROUTER_API_KEY=your-openrouter-api-key

# Per-agent keys (optional). If set, each specialist agent uses its own key,
# for role-specific routing; account/provider limits can still be shared.
# Unset keys fall back to OPENROUTER_API_KEY above.
OPENROUTER_API_KEY_FINANCIAL=your-financial-agent-key
OPENROUTER_API_KEY_MARKET=your-market-agent-key
OPENROUTER_API_KEY_SENTIMENT=your-sentiment-agent-key

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=Multi-Agent-Crypto

# Per-agent models (optional). If unset, fallback to OPENROUTER_MODEL_NAME.
# Check current availability and provider limits before an evaluation run.
OPENROUTER_MODEL_NAME_FINANCIAL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_MODEL_NAME_MARKET=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_MODEL_NAME_SENTIMENT=cohere/north-mini-code:free

# Conflict Analyzer (formerly Validator), Debate and Grounding also run on OpenRouter.
# OPENROUTER_MODEL_NAME_VALIDATOR is still read if the new name is unset.
OPENROUTER_MODEL_NAME_CONFLICT_ANALYZER=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_MODEL_NAME_DEBATE=dots-studio/dots-3-note-preview:free
OPENROUTER_MODEL_NAME_GROUNDING=inclusionai/ling-3.0-flash-sante:free

# These selected models support disabling reasoning. Blank = provider default.
# Re-check support if changing models: mandatory-reasoning models reject none.
OPENROUTER_REASONING_EFFORT=none

# Global fallback model if per-agent models are not set:
OPENROUTER_MODEL_NAME=google/gemma-4-26b-a4b-it:free

# ── Groq (no longer used by default) ────────────────────────────────────────
# Groq's free tier caps at 200k tokens/day, shared across conflict analyzer, debate and
# the grounding reviewer — that cap aborted mid-run evaluations, so these roles
# were moved to OpenRouter. Keep these set only if you switch a role back by
# setting its "provider" to "groq" in utils/config.py.
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# ── LM Studio (local fallback, used only if OPENROUTER_API_KEY is empty) ─────
BASE_URL=http://127.0.0.1:1234/v1
API_KEY=lm-studio

# ── Gemini (embeddings for the rag/ retrieval pipeline) ──────────────────────
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=models/text-embedding-004
