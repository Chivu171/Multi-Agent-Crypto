# ── OpenRouter (preferred backend — used if OPENROUTER_API_KEY is set) ───────
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=openai/gpt-oss-120b:free
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=Multi-Agent-Crypto

# ── LM Studio (local fallback, used only if OPENROUTER_API_KEY is empty) ─────
BASE_URL=http://127.0.0.1:1234/v1
API_KEY=lm-studio

# ── Per-agent model overrides ─────────────────────────────────────────────────
# NOTE: not currently read by utils/config.py (all agents use OPENROUTER_MODEL_NAME).
# Kept here for forward-compatibility; wire these up if/when per-agent models are added.
DEFAULT_MODEL=google/gemma-4-e4b
FINANCIAL_AGENT_MODEL=google/gemma-4-e4b
MARKET_AGENT_MODEL=google/gemma-4-e4b
SENTIMENT_AGENT_MODEL=google/gemma-4-e4b
VALIDATOR_AGENT_MODEL=google/gemma-4-e4b
MEDIATOR_AGENT_MODEL=google/gemma-4-e4b
